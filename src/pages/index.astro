---
// BIENVENIDA A ASTRO: Aquí arriba (entre los guiones) va el código del servidor. 
// Por ahora lo dejamos limpio, la magia visual está abajo.
---

<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Greydemar Serrano | Estrategia, Web & Ventas</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
</head>
<body>

  <!-- EFECTO DE LUZ DE FONDO -->
  <div class="glow"></div>

  <!-- SECCIÓN 1: HERO (El Gancho) -->
  <section class="hero reveal">
    <div class="badge">Disponible para nuevos proyectos</div>
    <h1 class="title">Convierto <span class="highlight">estrategia</span> en ingresos medibles.</h1>
    <p class="subtitle">Soy Greydemar Serrano. Conecto marketing, ventas y tecnología (IA + Web) para escalar tu presencia digital y acelerar tu crecimiento comercial.</p>
    <div class="hero-buttons">
      <a href="#contacto" class="btn-primary">Hablemos de tu proyecto</a>
      <a href="#servicios" class="btn-secondary">Ver cómo te ayudo</a>
    </div>
  </section>

  <!-- SECCIÓN 2: MARCAS (Social Proof / Clientes) -->
  <section class="brands reveal">
    <p class="section-label">MARCAS QUE HAN CONFIADO EN MI TRABAJO</p>
    <div class="brands-marquee">
      <!-- Aquí luego pondremos las imágenes (logos) de estas empresas -->
      <span>Eurobuilding Hotels & Suites</span> • 
      <span>PanHouse Editorial</span> • 
      <span>YP Realty</span> • 
      <span>ISMM</span> • 
      <span>Active Learning Education</span>
    </div>
  </section>

  <!-- SECCIÓN 3: SERVICIOS (Cómo puedo ayudarte) -->
  <section id="servicios" class="services reveal">
    <h2 class="section-title">¿Cómo puedo ayudarte?</h2>
    <div class="bento-grid">
      
      <div class="bento-card">
        <div class="icon">💻</div>
        <h3>Desarrollo Web & Landing Pages</h3>
        <p>Diseño ecosistemas web ultrarrápidos (Astro, Next.js) enfocados en la captación de leads y alta conversión.</p>
      </div>

      <div class="bento-card">
        <div class="icon">📈</div>
        <h3>Estrategia & Social Media</h3>
        <p>Edición de video con "hooks" virales y gestión de comunidades. En YP Realty aumenté las interacciones un 604%.</p>
      </div>

      <div class="bento-card">
        <div class="icon">🤖</div>
        <h3>Automatización con IA & CRM</h3>
        <p>Integro ChatGPT y Claude para reducir tiempos de atención y estandarizar tu comunicación interna y externa.</p>
      </div>

      <div class="bento-card">
        <div class="icon">🤝</div>
        <h3>Estrategia de Ventas B2B/B2C</h3>
        <p>Desde prospección (Cold Calling) hasta el cierre de matriculas High-Ticket, optimizando todo el embudo.</p>
      </div>

    </div>
  </section>

  <!-- SECCIÓN 4: EXPERIENCIA Y PROYECTOS -->
  <section id="experiencia" class="experience reveal">
    <h2 class="section-title">Mi Trayectoria</h2>
    
    <div class="timeline">
      <div class="timeline-item">
        <h4>Social Media Manager & Video Editor</h4>
        <span class="company">YP Realty (Puerto Rico) | 2026 - Presente</span>
        <p>Lidero la estrategia de contenidos, edición de Reels/Shorts y aplicación de SEO para conversión inmobiliaria.</p>
        <!-- Espacio para tu video/imagen del proyecto -->
        <div class="media-placeholder">🎥 Espacio para Video de YP Realty</div>
      </div>

      <div class="timeline-item">
        <h4>Coordinadora de Comunicaciones Internas</h4>
        <span class="company">PanHouse | 2024 - 2025</span>
        <p>Sincronicé operaciones entre Marketing, Ventas y PR. Integré sistemas de IA reduciendo drásticamente los tiempos de atención.</p>
      </div>

      <div class="timeline-item">
        <h4>Coordinadora B2B & Business Center</h4>
        <span class="company">Eurobuilding Hotels & Suites | 2022 - 2023</span>
        <p>Gestioné portafolio corporativo B2B bajo estándares 5 estrellas con 100% de resolución en incidencias.</p>
      </div>
    </div>
  </section>

  <!-- ESTILOS (CSS PREMIUM) -->
  <style>
    :root {
      --bg: #0a0a0a;
      --text: #ffffff;
      --text-muted: #a3a3a3;
      --accent: #d4af37; /* Tono dorado premium elegante */
      --card-bg: rgba(255, 255, 255, 0.03);
      --card-border: rgba(255, 255, 255, 0.1);
    }

    body {
      margin: 0;
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Brillo de fondo estilo Apple */
    .glow {
      position: absolute;
      top: -20%;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(212,175,55,0.15) 0%, rgba(0,0,0,0) 70%);
      z-index: -1;
    }

    /* Layout general */
    section {
      max-width: 1000px;
      margin: 0 auto;
      padding: 100px 20px;
    }

    /* Hero */
    .hero {
      text-align: center;
      padding-top: 150px;
    }
    .badge {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 20px;
      background: rgba(212, 175, 55, 0.1);
      color: var(--accent);
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 24px;
      border: 1px solid rgba(212, 175, 55, 0.3);
    }
    .title {
      font-size: 4rem;
      font-weight: 800;
      letter-spacing: -1px;
      margin: 0 0 20px 0;
      line-height: 1.1;
    }
    .highlight {
      background: linear-gradient(90deg, #fff, var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .subtitle {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 700px;
      margin: 0 auto 40px auto;
    }

    /* Botones */
    .hero-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
    }
    .btn-primary, .btn-secondary {
      padding: 14px 28px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    .btn-primary {
      background: var(--text);
      color: var(--bg);
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(255,255,255,0.2); }
    
    .btn-secondary {
      background: var(--card-bg);
      color: var(--text);
      border: 1px solid var(--card-border);
    }
    .btn-secondary:hover { background: rgba(255,255,255,0.1); }

    /* Marcas */
    .brands { text-align: center; padding: 40px 20px; }
    .section-label { color: var(--text-muted); font-size: 12px; letter-spacing: 2px; margin-bottom: 20px; }
    .brands-marquee { color: var(--text-muted); font-size: 1.2rem; font-weight: 600; word-spacing: 15px;}

    /* Títulos de sección */
    .section-title { font-size: 2.5rem; margin-bottom: 40px; text-align: left; }

    /* Bento Grid (Servicios) */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }
    .bento-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 30px;
      transition: transform 0.3s ease, background 0.3s ease;
    }
    .bento-card:hover {
      transform: translateY(-5px);
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(212, 175, 55, 0.4);
    }
    .bento-card .icon { font-size: 2rem; margin-bottom: 16px; }
    .bento-card h3 { margin: 0 0 10px 0; font-size: 1.3rem; }
    .bento-card p { color: var(--text-muted); margin: 0; font-size: 0.95rem; }

    /* Timeline (Experiencia) */
    .timeline {
      border-left: 2px solid var(--card-border);
      padding-left: 30px;
      margin-left: 20px;
    }
    .timeline-item { position: relative; margin-bottom: 50px; }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: -37px;
      top: 5px;
      width: 12px;
      height: 12px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent);
    }
    .timeline-item h4 { margin: 0; font-size: 1.4rem; }
    .company { display: block; color: var(--accent); font-size: 0.9rem; margin-bottom: 10px; font-weight: 600; }
    .media-placeholder {
      width: 100%;
      height: 250px;
      background: var(--card-bg);
      border: 1px dashed var(--card-border);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 15px;
      color: var(--text-muted);
    }

    /* Animaciones de Scroll */
    .reveal {
      opacity: 0;
      transform: translateY(50px);
      transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 768px) {
      .title { font-size: 2.5rem; }
      .hero-buttons { flex-direction: column; }
    }
  </style>

  <!-- SCRIPT PARA EL EFECTO DE DESLIZAMIENTO -->
  <script>
    function reveal() {
      var reveals = document.querySelectorAll(".reveal");
      for (var i = 0; i < reveals.length; i++) {
        var windowHeight = window.innerHeight;
        var elementTop = reveals[i].getBoundingClientRect().top;
        var elementVisible = 100;
        if (elementTop < windowHeight - elementVisible) {
          reveals[i].classList.add("active");
        }
      }
    }
    window.addEventListener("scroll", reveal);
    reveal(); // Para activar los primeros elementos al cargar
  </script>

</body>
</html>
